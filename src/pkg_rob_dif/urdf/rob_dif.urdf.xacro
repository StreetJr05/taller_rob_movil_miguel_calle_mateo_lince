<?xml version="1.0"?>
<!-- Differential drive robot: box chassis, two drive wheels and a spherical caster -->
<robot name="robot_diferencial" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Parameters ===================== -->
  <!-- Chassis -->
  <xacro:property name="base_length" value="0.4"/>
  <xacro:property name="base_width"  value="0.3"/>
  <xacro:property name="base_height" value="0.12"/>
  <xacro:property name="base_mass"   value="1.0"/>

  <!-- Drive wheels -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.2"/>
  <xacro:property name="wheel_x"      value="0.10"/>   <!-- forward offset from chassis center -->
  <!-- Distance between wheel centers (b). Must leave a gap to the chassis side:
       b/2 - wheel_width/2 > base_width/2  ->  0.18 - 0.02 = 0.16 > 0.15 -->
  <xacro:property name="wheel_separation" value="0.36"/>
  <xacro:property name="wheel_y"      value="${wheel_separation/2}"/>
  <xacro:property name="wheel_z"      value="${-base_height/2}"/>

  <!-- Caster: its bottom touches the ground at the same height as the wheels -->
  <xacro:property name="caster_radius" value="0.025"/>
  <xacro:property name="caster_mass"   value="0.05"/>
  <xacro:property name="caster_x"      value="${-base_length/2 + caster_radius + 0.02}"/>
  <xacro:property name="caster_z"      value="${wheel_z - wheel_radius + caster_radius}"/>

  <!-- Height of the chassis center above the ground -->
  <xacro:property name="base_z" value="${wheel_radius - wheel_z}"/>

  <!-- ===================== Sensor parameters ===================== -->
  <!-- Lidar: 2D, full turn, 1 deg resolution. max_angle stops one step short of +pi
       so the first and last rays do not point in the same direction. -->
  <xacro:property name="lidar_samples"   value="360"/>
  <xacro:property name="lidar_min_angle" value="${-pi}"/>
  <xacro:property name="lidar_max_angle" value="${pi - 2*pi/lidar_samples}"/>
  <xacro:property name="lidar_range_min" value="0.15"/>
  <xacro:property name="lidar_range_max" value="12.0"/>
  <xacro:property name="lidar_rate"      value="10"/>
  <xacro:property name="lidar_noise"     value="0.01"/>   <!-- range std dev [m] -->

  <!-- Camera: mounted on the front face of the chassis -->
  <xacro:property name="camera_x"      value="${base_length/2 + 0.01}"/>
  <xacro:property name="camera_z"      value="0.03"/>
  <xacro:property name="camera_hfov"   value="1.047"/>   <!-- 60 deg -->
  <xacro:property name="camera_width"  value="640"/>
  <xacro:property name="camera_height" value="480"/>
  <xacro:property name="camera_rate"   value="30"/>
  <xacro:property name="camera_noise"  value="0.007"/>  <!-- pixel std dev, normalized [0,1] -->

  <!-- ===================== Materials ===================== -->
  <material name="amarillo">
    <color rgba="0.88 0.68 0.00 1"/>
  </material>
  <material name="negro">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="gris">
    <color rgba="0.6 0.6 0.6 1"/>
  </material>

  <!-- ===================== Inertia macros ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12.0*(y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${m/12.0*(x*x + z*z)}" iyz="0.0"
               izz="${m/12.0*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder whose axis is rotated to lie along Y -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m/12.0*(3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${m/12.0*(3*r*r + h*h)}" iyz="0.0"
               izz="${m/2.0*r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2.0/5.0*m*r*r}" ixy="0.0" ixz="0.0"
               iyy="${2.0/5.0*m*r*r}" iyz="0.0"
               izz="${2.0/5.0*m*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== Links ===================== -->
  <!-- Footprint on the ground plane -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="amarillo"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- base_footprint sits on the ground directly under the wheel axle midpoint,
       which is the point a differential robot rotates about. The chassis is shifted
       back by wheel_x so the wheels end up under base_footprint. -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="${-wheel_x} 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- Drive wheel macro: side = left/right, reflect = 1/-1 -->
  <xacro:macro name="wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="negro"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${reflect*wheel_y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- Spherical caster wheel -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="gris"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <!-- URDF has no ball joint: emulate it with three continuous joints (X, Y, Z)
       chained through two massless-like intermediate links at the sphere center -->
  <xacro:macro name="dummy_inertia">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0.0" ixz="0.0" iyy="1e-7" iyz="0.0" izz="1e-7"/>
    </inertial>
  </xacro:macro>

  <link name="caster_x_link">
    <xacro:dummy_inertia/>
  </link>
  <link name="caster_y_link">
    <xacro:dummy_inertia/>
  </link>

  <joint name="caster_x_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_x_link"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <joint name="caster_y_joint" type="continuous">
    <parent link="caster_x_link"/>
    <child link="caster_y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="caster_z_joint" type="continuous">
    <parent link="caster_y_link"/>
    <child link="caster_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- With friction the sphere rolls on the ground instead of sliding -->
  <gazebo reference="caster_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ===================== Sensors ===================== -->
  <!-- Lidar -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.1 0 0.08" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>${lidar_rate}</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_min_angle}</min_angle>
            <max_angle>${lidar_max_angle}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_range_min}</min>
          <max>${lidar_range_max}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_noise}</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame (REP 103): z forward, x right, y down. Image and camera_info
       are stamped with this frame so image-processing tools project correctly. -->
  <link name="camera_optical_frame"/>

  <joint name="joint_camera_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="camara" type="camera">
      <topic>image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>${camera_rate}</update_rate>
      <camera>
        <camera_info_topic>camera_info</camera_info_topic>
        <horizontal_fov>${camera_hfov}</horizontal_fov>
        <image>
          <width>${camera_width}</width>
          <height>${camera_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${camera_noise}</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== Differential drive plugin ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- ===================== Joint state publisher ===================== -->
  <!-- Publishes wheel/caster joint positions so robot_state_publisher can build their TF -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

  <!-- ===================== Ground truth ===================== -->
  <!-- True pose of the robot taken from the simulator (no wheel slip, no integration
       error). Used only to evaluate the odometries, never for control. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>ground_truth</odom_topic>
      <tf_topic>ground_truth/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

</robot>
